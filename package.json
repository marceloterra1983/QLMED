{
  "name": "qlmed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "fuser -k 3000/tcp 2>/dev/null; sleep 0.5; QLMED_DISABLE_BACKGROUND_SERVICES=${QLMED_DISABLE_BACKGROUND_SERVICES:-true} next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "docs:validate": "node ./scripts/validate-docs.mjs",
    "docs:validate:test": "bash ./scripts/test-docs-validator.sh",
    "check:deploy": "bash ./scripts/check-deploy-alignment.sh",
    "deploy:server": "bash ./scripts/deploy-server.sh --legacy",
    "publish:server": "bash ./scripts/publish-server.sh",
    "rollback:server": "bash ./scripts/rollback-server.sh --legacy",
    "alias:install": "bash ./scripts/install-git-alias.sh",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:verify": "bash ./scripts/verify-migrations.sh",
    "db:reconcile:verify": "bash ./scripts/verify-reconciliation.sh",
    "db:config:verify": "node ./scripts/validate-database-config.mjs",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:integration": "RUN_DB_INTEGRATION_TESTS=1 QLMED_DISABLE_BACKGROUND_SERVICES=true vitest run src/lib/__tests__/*.integration.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tanstack/react-virtual": "^3.14.9",
    "bcryptjs": "^3.0.3",
    "chokidar": "^5.0.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "15.5.22",
    "next-auth": "4.24.15",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prisma": "7.9.1",
    "puppeteer": "^25.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "xml-crypto": "^6.1.2",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.19",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1",
    "postcss": "8.5.25",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "@prisma/dev": {
      "@hono/node-server": "2.0.11",
      "valibot": "1.4.2"
    },
    "sharp": "^0.35.3"
  }
}
