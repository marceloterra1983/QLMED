generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──

enum InvoiceType {
  NFE
  CTE
  NFSE
}

enum InvoiceDirection {
  received
  issued
}

enum InvoiceStatus {
  received
  confirmed
  rejected
}

enum SyncMethod {
  sefaz
  nsdocs
  receita_nfse
}

enum SyncStatus {
  running
  completed
  partial
  error
}

enum UserRole {
  admin
  editor
  viewer
}

enum UserStatus {
  pending
  active
  inactive
  rejected
}

enum AccessLogAction {
  login
  login_failed
  logout
  navigation
  api_key_used
  user_created
  user_updated
  user_deleted
  role_changed
  status_changed
  pages_changed
  permission_denied
  account_locked
  notification_resolved
}

enum NotificationEventType {
  invoice_received
}

enum NotificationChannel {
  email
  whatsapp
  push
}

enum NotificationDeliveryStatus {
  pending
  processing
  sent
  retry
  uncertain
  dead
}

// ── Models ──

model User {
  id             String      @id @default(cuid())
  email          String      @unique
  passwordHash   String
  name           String
  phone          String?
  role           UserRole    @default(viewer)
  status         UserStatus  @default(pending)
  allowedPages   String[]    @default([])
  // PIN brute-force protection: incremented on failed login, reset on success.
  // lockedUntil is a soft lock — authorize() rejects the login while now < lockedUntil.
  failedAttempts Int         @default(0)
  lockedUntil    DateTime?
  // Session revocation counter — every issued JWT embeds this value in its
  // `tokenVersion` claim. Increment to invalidate ALL outstanding sessions
  // for this user (logout-everywhere, role demotion, status change, etc.).
  tokenVersion   Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  companies      Company[]
  accessLogs     AccessLog[]
  apiKeys        ApiKey[]    @relation("ApiKeyCreator")
  notificationPreferences UserNotificationPreference[]
  pushSubscriptions       PushSubscription[]
}

// Named API keys used by external integrations (n8n, scripts). Each row
// stores a SHA-256 hash of the raw key — the clear value is shown once
// at creation time and never retrievable afterward. Revocation is a soft
// delete via revokedAt so historical audit trails keep pointing to a
// valid row.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  scopes      String[]  @default([])
  createdById String
  createdBy   User      @relation("ApiKeyCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  @@index([revokedAt])
}

model AccessLog {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    AccessLogAction
  path      String?
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Company {
  id                  String                                 @id @default(cuid())
  cnpj                String                                 @unique
  razaoSocial         String
  nomeFantasia        String?
  userId              String
  user                User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices            Invoice[]
  duplicataOverrides  FinanceiroDuplicataOverride[]
  manualInstallments  FinanceiroDuplicataManualInstallment[]
  contactNicknames    ContactNickname[]
  contactOverrides    ContactOverride[]
  nsdocsConfig        NsdocsConfig?
  receitaNfseConfig   ReceitaNfseConfig?
  n8nConfig           N8nIntegrationConfig?
  certificateConfig   CertificateConfig?
  oneDriveConnections OneDriveConnection[]
  syncLogs            SyncLog[]
  notificationEvents  NotificationOutboxEvent[]
  productRebuildState ProductAggregateRebuildState?
  impcgAuthorizations   ImpcgAuthorization[]
  impcgSourceMessages   ImpcgSourceMessage[]
  impcgIngestState      ImpcgIngestState?
  cassemsAuthorizations CassemsAuthorization[]
  cassemsSourceMessages CassemsSourceMessage[]
  cassemsIngestState    CassemsIngestState?
  invoiceEmissions      InvoiceEmission[]
  createdAt           DateTime                               @default(now())
  updatedAt           DateTime                               @updatedAt

  @@index([userId])
}

model NsdocsConfig {
  id           String    @id @default(cuid())
  apiToken     String
  companyId    String    @unique
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  autoSync     Boolean   @default(true)
  syncInterval Int       @default(60)
  lastNsu      String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Configuracao da integracao de LEITURA com o n8n (QLMED -> n8n).
/// Nao confundir com o webhook de ENTRADA em src/app/api/webhooks/n8n, que e o
/// sentido oposto e usa QLMED_API_KEY. Sao credenciais e direcoes distintas.
///
/// apiToken guarda a chave do cabecalho X-N8N-API-KEY, cifrada por lib/crypto,
/// e nunca sai em claro: a rota de config devolve mascarado, como NsdocsConfig.
/// Ver specs/011-n8n-workflow-status/
model N8nIntegrationConfig {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  baseUrl   String
  apiToken  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model ReceitaNfseConfig {
  id           String    @id @default(cuid())
  companyId    String    @unique
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  apiToken     String?
  autoSync     Boolean   @default(true)
  syncInterval Int       @default(60)
  environment  String    @default("production")
  baseUrl      String?
  cnpjConsulta String?
  lastNsu      String    @default("000000000000000")
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
}

model CertificateConfig {
  id              String    @id @default(cuid())
  companyId       String    @unique
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pfxData         Bytes
  pfxPassword     String
  serialNumber    String?
  issuer          String?
  subject         String?
  validFrom       DateTime?
  validTo         DateTime?
  cnpjCertificate String?
  environment     String    @default("production")
  lastNsu         String    @default("000000000000000")
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SyncLog {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  syncMethod   SyncMethod @default(sefaz)
  status       SyncStatus @default(running)
  newDocs      Int        @default(0)
  updatedDocs  Int        @default(0)
  skippedDocs  Int        @default(0)
  errorMessage String?
  startedAt    DateTime   @default(now())
  completedAt  DateTime?

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, syncMethod, status])
}

model OneDriveConnection {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountEmail    String
  accountName     String?
  microsoftUserId String?
  driveId         String
  driveType       String?
  driveWebUrl     String?
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime
  scope           String?
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, accountEmail])
  @@index([companyId])
}

model Invoice {
  id                 String                                 @id @default(cuid())
  accessKey          String                                 @unique
  type               InvoiceType
  direction          InvoiceDirection                       @default(received)
  number             String
  series             String?
  issueDate          DateTime
  senderCnpj         String
  senderName         String
  recipientCnpj      String?
  recipientName      String?
  totalValue         Decimal
  status             InvoiceStatus                          @default(received)
  cancelledAt        DateTime?
  cfop               String?
  xmlContent         String
  companyId          String
  company            Company                                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  duplicataOverrides FinanceiroDuplicataOverride[]
  manualInstallments FinanceiroDuplicataManualInstallment[]
  notificationEvent  NotificationOutboxEvent?
  createdAt          DateTime                               @default(now())
  updatedAt          DateTime                               @updatedAt

  @@index([companyId])
  @@index([senderCnpj])
  @@index([issueDate])
  @@index([companyId, type, direction])
  @@index([companyId, type, direction, issueDate])
  @@index([companyId, type, direction, senderCnpj])
  @@index([companyId, status])
  @@index([companyId, cfop])
  @@index([senderName])
  @@index([recipientCnpj])
  @@index([companyId, recipientCnpj])
}

/// Preferencia de notificacao de um usuario para um tipo de evento.
/// Ausencia de linha significa o padrao do tipo, declarado em
/// src/lib/notification-preferences.ts — nunca "desligado".
/// Sem companyId de proposito: pertence a uma identidade, nao a um tenant,
/// como AccessLog e ApiKey. Ver specs/010-user-notification-preferences/data-model.md
model UserNotificationPreference {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType NotificationEventType
  enabled   Boolean
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([userId, eventType])
  @@index([eventType, enabled])
}

/// Inscricao Web Push de um aparelho. Sem companyId: pertence a identidade,
/// como UserNotificationPreference (SPEC-016 / ADR-0011).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model NotificationOutboxEvent {
  id         String                 @id @default(cuid())
  eventKey   String                 @unique
  eventType  NotificationEventType  @default(invoice_received)
  companyId  String
  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId  String                 @unique
  invoice    Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt  DateTime               @default(now())
  deliveries NotificationDelivery[]

  @@index([eventType, createdAt])
  @@index([companyId, createdAt])
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  eventId           String
  event             NotificationOutboxEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  recipient         String
  idempotencyKey    String                     @unique
  status            NotificationDeliveryStatus @default(pending)
  attempts          Int                        @default(0)
  availableAt       DateTime                   @default(now())
  lockedAt          DateTime?
  lockToken         String?
  submittingAt      DateTime?
  sentAt            DateTime?
  providerMessageId String?
  lastError         String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  clicks            NotificationClick[]

  @@unique([eventId, channel, recipient])
  @@index([status, availableAt, createdAt])
  @@index([eventId, status])
}

model NotificationClick {
  id         String               @id @default(cuid())
  deliveryId String
  delivery   NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  targetPath String               @default("/fiscal/invoices")
  userAgent  String?
  ipHash     String?
  createdAt  DateTime             @default(now())

  @@index([deliveryId, createdAt])
  @@index([createdAt])
}

model ProductAggregateRebuildState {
  companyId       String   @id
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cutoffCreatedAt DateTime
  completedAt     DateTime
}

model FinanceiroDuplicataOverride {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId             String
  invoice               Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  dupNumeroOriginal     String
  dupVencimentoOriginal String
  emitenteNome          String?
  emitenteCnpj          String?
  faturaNumero          String?
  dupNumero             String?
  dupVencimento         String?
  dupValor              Decimal?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, invoiceId, dupNumeroOriginal, dupVencimentoOriginal], map: "company_invoice_dup_original")
  @@index([companyId])
  @@index([invoiceId])
  @@index([companyId, invoiceId])
}

model ContactNickname {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cnpj      String
  shortName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, cnpj])
  @@index([companyId])
}

model ContactOverride {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cnpj       String
  phone      String?
  email      String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  zipCode    String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, cnpj])
  @@index([companyId])
}

model FinanceiroDuplicataManualInstallment {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  dupNumero     String
  dupVencimento String
  dupValor      Decimal
  dupDesconto   Decimal  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, invoiceId, dupNumero], map: "company_invoice_manual_dup_num")
  @@index([companyId])
  @@index([invoiceId])
  @@index([companyId, invoiceId])
}

// ── Satellite tables (versioned by the schema11 baseline) ──

// Satellite table baselined in Phase 11; store uses Prisma Client (no runtime DDL).
model InvoiceTaxTotals {
  invoiceId  String    @id @map("invoice_id")
  companyId  String    @map("company_id")
  vbc        Float?
  vicms      Float?
  vpis       Float?
  vcofins    Float?
  vipi       Float?
  vfrete     Float?
  vseg       Float?
  vdesc      Float?
  voutro     Float?
  vtottrib   Float?
  vfcp       Float?
  vicmsSt    Float?    @map("vicms_st")
  computedAt DateTime? @default(now()) @map("computed_at") @db.Timestamptz

  @@index([companyId])
  @@map("invoice_tax_totals")
}

// Satellite table baselined in Phase 11; store uses Prisma Client (no runtime DDL).
model InvoiceItemTax {
  id                 String  @id
  invoiceId          String  @map("invoice_id")
  companyId          String  @map("company_id")
  itemNumber         Int?    @map("item_number")
  productCode        String? @map("product_code")
  productDescription String? @map("product_description")
  ncm                String?
  cfop               String?
  cest               String?
  origem             String?
  quantity           Float?
  unitPrice          Float?  @map("unit_price")
  totalValue         Float?  @map("total_value")
  cstIcms            String? @map("cst_icms")
  baseIcms           Float?  @map("base_icms")
  aliqIcms           Float?  @map("aliq_icms")
  valorIcms          Float?  @map("valor_icms")
  cstPis             String? @map("cst_pis")
  aliqPis            Float?  @map("aliq_pis")
  valorPis           Float?  @map("valor_pis")
  cstCofins          String? @map("cst_cofins")
  aliqCofins         Float?  @map("aliq_cofins")
  valorCofins        Float?  @map("valor_cofins")
  aliqIpi            Float?  @map("aliq_ipi")
  valorIpi           Float?  @map("valor_ipi")
  valorFcp           Float?  @map("valor_fcp")

  @@index([invoiceId])
  @@index([companyId, cfop])
  @@map("invoice_item_tax")
}

// Satellite table baselined in Phase 11; store uses Prisma Client (no runtime DDL).
model ContactFiscal {
  id              String    @id
  companyId       String    @map("company_id")
  cnpj            String
  ie              String?
  im              String?
  crt             String?
  uf              String?
  city            String?
  sourceInvoiceId String?   @map("source_invoice_id")
  extractedAt     DateTime? @default(now()) @map("extracted_at") @db.Timestamptz

  @@unique([companyId, cnpj])
  @@index([companyId])
  @@map("contact_fiscal")
}

// Satellite table baselined in Phase 11; store uses Prisma Client (no runtime DDL).
model InvoiceDuplicata {
  id                  String   @id
  invoiceId           String   @map("invoice_id")
  companyId           String   @map("company_id")
  dupNumero           String?  @map("dup_numero")
  dupVencimento       String   @map("dup_vencimento")
  dupValor                   Float     @map("dup_valor")
  dupValorDecimal            Decimal?  @map("dup_valor_decimal")
  faturaNumero               String?   @map("fatura_numero")
  faturaValorOriginal        Float?    @map("fatura_valor_original")
  faturaValorOriginalDecimal Decimal?  @map("fatura_valor_original_decimal")
  faturaValorLiquido         Float?    @map("fatura_valor_liquido")
  faturaValorLiquidoDecimal  Decimal?  @map("fatura_valor_liquido_decimal")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([invoiceId, dupNumero, dupVencimento])
  @@index([companyId])
  @@index([invoiceId])
  @@map("invoice_duplicata")
}

// Baseline: physical table predated Prisma ownership; store uses Prisma Client (Phase 11).
model NcmCache {
  code            String   @id
  descricao       String   @default("")
  parentCode      String?  @map("parent_code")
  fullDescription String   @default("") @map("full_description")
  hierarchy       Json     @default("[]")
  fetchedAt       DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  @@index([parentCode])
  @@map("ncm_cache")
}

// Baseline: physical table predated Prisma ownership; store uses Prisma Client (Phase 11).
