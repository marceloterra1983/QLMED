  anvisaStatus              String?   @map("anvisa_status")
  anvisaExpiration          String?   @map("anvisa_expiration")
  anvisaRiskClass           String?   @map("anvisa_risk_class")
  anvisaManufacturer        String?   @map("anvisa_manufacturer")
