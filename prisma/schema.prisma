  description     String
  brand           String?
  reference       String?
  quantity        Decimal
  unitAmount      Decimal
  lineTotal       Decimal
  sortOrder       Int
  createdAt       DateTime           @default(now())

  @@index([authorizationId, sortOrder])
}

model ImpcgSourceMessage {
  id                String              @id @default(cuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authorizationId   String?
  authorization     ImpcgAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)
  mailbox           String
  graphMessageId    String
  internetMessageId String
  receivedAt        DateTime
  whatsappSentAt    DateTime?
  whatsappMessageId String?
  createdAt         DateTime            @default(now())

  @@unique([companyId, internetMessageId])
  @@index([companyId])
  @@index([authorizationId])
}

model ImpcgIngestState {
