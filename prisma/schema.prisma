  ok
  parcial
  falha
}

enum CassemsParseStatus {
  ok
  parcial
  falha
}

model ImpcgAuthorization {
  id              String                   @id @default(cuid())
  companyId       String
  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  oficioNumber    String
  issuedAt        DateTime?
  patientName     String
  patientRegistry String?
  doctorName      String?
  doctorCrm       String?
  procedureName   String?
  hospitalName    String?
  totalAmount     Decimal
  oneDriveItemId  String
  fileName        String
  parseStatus     ImpcgParseStatus
  editedFields    String[]                 @default([])
  receivedAt      DateTime
  items           ImpcgAuthorizationItem[]
  sourceMessages  ImpcgSourceMessage[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([companyId, oficioNumber])
  @@index([companyId])
  @@index([companyId, issuedAt(sort: Desc)])
}

model ImpcgAuthorizationItem {
  id              String             @id @default(cuid())
  authorizationId String
  authorization   ImpcgAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
