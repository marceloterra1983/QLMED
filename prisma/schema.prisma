  @@unique([companyId, productKey])
  @@index([companyId])
  @@index([companyId, anvisaCode])
  @@map("product_registry")
}

// Satellite table baselined in Phase 11; store uses Prisma Client (no runtime DDL).
model StockEntry {
  id            String    @id
  companyId     String    @map("company_id")
  invoiceId     String    @map("invoice_id")
  invoiceNumber String?   @map("invoice_number")
  supplierName  String?   @map("supplier_name")
  supplierCnpj  String?   @map("supplier_cnpj")
  issueDate     DateTime? @map("issue_date") @db.Timestamptz
  totalValue    Float?    @map("total_value")
  totalItems    Int?      @default(0) @map("total_items")
  matchedItems  Int?      @default(0) @map("matched_items")
  status        String    @default("pending")
  registeredAt  DateTime? @map("registered_at") @db.Timestamptz
  registeredBy  String?   @map("registered_by")
  emitterCity   String?   @map("emitter_city")
  emitterState  String?   @map("emitter_state")
  accessKey     String?   @map("access_key")
  cfop          String?
  totVprod      Float?    @map("tot_vprod")
  totVdesc      Float?    @map("tot_vdesc")
  totVbc        Float?    @map("tot_vbc")
  totVicms      Float?    @map("tot_vicms")
  totVbcSt      Float?    @map("tot_vbc_st")
  totVicmsSt    Float?    @map("tot_vicms_st")
  totVfrete     Float?    @map("tot_vfrete")
  totVseg       Float?    @map("tot_vseg")
  totVoutro     Float?    @map("tot_voutro")
  totVipi       Float?    @map("tot_vipi")
  totVpis       Float?    @map("tot_vpis")
  totVcofins    Float?    @map("tot_vcofins")
