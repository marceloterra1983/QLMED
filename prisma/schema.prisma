  productType               String?   @map("product_type")
  productSubtype            String?   @map("product_subtype")
  productSubgroup           String?   @map("product_subgroup")
  outOfLine                 Boolean?  @default(false) @map("out_of_line")
  instrumental              Boolean?  @default(false)
  codigo                    String?
  fiscalSitTributaria       String?   @map("fiscal_sit_tributaria")
  fiscalNomeTributacao      String?   @map("fiscal_nome_tributacao")
  fiscalIcms                Float?    @map("fiscal_icms")
  fiscalPis                 Float?    @map("fiscal_pis")
  fiscalCofins              Float?    @map("fiscal_cofins")
  fiscalObs                 String?   @map("fiscal_obs")
  fiscalCest                String?   @map("fiscal_cest")
  fiscalOrigem              String?   @map("fiscal_origem")
  fiscalCfopEntrada         String?   @map("fiscal_cfop_entrada")
  fiscalCfopSaida           String?   @map("fiscal_cfop_saida")
  fiscalIpi                 Float?    @map("fiscal_ipi")
  fiscalFcp                 Float?    @map("fiscal_fcp")
  fiscalCstIpi              String?   @map("fiscal_cst_ipi")
  fiscalCstPis              String?   @map("fiscal_cst_pis")
  fiscalCstCofins           String?   @map("fiscal_cst_cofins")
  fiscalObsIcms             String?   @map("fiscal_obs_icms")
  fiscalObsPisCofins        String?   @map("fiscal_obs_pis_cofins")
  productRefs               String[]  @default([]) @map("product_refs")
  defaultSupplier           String?   @map("default_supplier")
  aggTotalQuantity          Float?    @map("agg_total_quantity")
  aggTotalValue             Float?    @map("agg_total_value")
  aggInvoiceCount           Int?      @map("agg_invoice_count")
  aggLastPrice              Float?    @map("agg_last_price")
  aggAveragePrice           Float?    @map("agg_average_price")
  aggLastIssueDate          DateTime? @map("agg_last_issue_date") @db.Timestamptz
  aggLastSupplierName       String?   @map("agg_last_supplier_name")
  aggLastSupplierCnpj       String?   @map("agg_last_supplier_cnpj")
  aggLastInvoiceNumber      String?   @map("agg_last_invoice_number")
  aggLastSaleDate           DateTime? @map("agg_last_sale_date") @db.Timestamptz
  aggLastSalePrice          Float?    @map("agg_last_sale_price")
