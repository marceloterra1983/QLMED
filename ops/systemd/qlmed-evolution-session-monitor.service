[Unit]
Description=QLMED Evolution HTTP and WhatsApp session monitor
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/qlmed-evolution-session-monitor.sh --check
Environment=QLMED_EVOLUTION_API_URL=http://127.0.0.1:8085
Environment=OPS_ENV=/srv/qlmed/services/nfe-notify/.env
StateDirectory=qlmed-evolution-session-monitor
LogsDirectory=qlmed-evolution-session-monitor
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/qlmed-evolution-session-monitor /var/log/qlmed-evolution-session-monitor
TimeoutStartSec=60
# 0=open/recovered, 1=session unavailable, 2=monitor or alert transport
# failure.  An e-mail transport failure is therefore not silently successful.
SuccessExitStatus=0 1
Restart=no
