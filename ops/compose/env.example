# Copie para .env ao lado do compose, com modo 0600. Nunca commitar valores reais.
# Estas duas são interpoladas no próprio YAML (${VAR}) — precisam estar no
# ambiente do shell ou num --env-file no momento do `docker compose up`.
POSTGRES_PASSWORD=replace-with-production-postgres-password
QLMED_API_KEY=replace-with-qlmed-api-key

# Os serviços leem ainda os env_file por serviço, que NÃO estão versionados:
#   env/app.env
#   env/n8n-db.env
#   env/n8n.env  env/n8n-legacy.env  env/n8n-recovered.env
# Os quatro arquivos de n8n são camadas acumuladas na recuperação de 29/07/2026,
# aplicadas em ordem. Consolidar em um só é dívida técnica registrada.
